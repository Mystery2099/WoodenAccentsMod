{
  "schemaVersion": 1,
  "authors": [
    "Mystery2099"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/wooden-accents-mod",
    "sources": "https://github.com/Mystery2099/WoodenAccentsMod",
    "issues": "https://github.com/Mystery2099/WoodenAccentsMod/issues"
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.19.4",
    "java": ">=17",
    "fabric-api": "*",
