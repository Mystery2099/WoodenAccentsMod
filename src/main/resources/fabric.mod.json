  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.12+1.20.1",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "voxlib": ">=1.6.1+1.20.1"
  },
  "description": "Vanilla-scale furniture and structural accents for every wood type.",
  "entrypoints": {
    "main": [
      {
        "value": "com.github.mystery2099.woodenAccentsMod.WoodenAccentsMod",
        "adapter": "kotlin"
      }
